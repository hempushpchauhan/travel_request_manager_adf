<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Throw an error message if Departure Date is in the past</description>
        <field>departure_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Department Date Validation</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   //Display error message when departure_date is before today's date
   var departure_date = g_form.getValue('departure_date');
   var today = new Date().toISOString().split('T')[0];
   
   if (departure_date < today) {
	g_form.addErrorMessage('The "Departure Date" cannot be in the past!');
	g_form.setValue('departure_date', '');
   }
}]]></script>
